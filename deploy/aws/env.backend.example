# DEPLOY-AWS-1 — env productivo del backend (agro-score-api).
# Copiar a deploy/aws/.env.backend en la EC2 y completar los secretos reales.
# Nunca commitear .env.backend con valores reales.
#
# OJO: las variables de conexión a Postgres son DB_HOST/DB_PORT/DB_USER/
# DB_PASSWORD/DB_NAME (así las lee src/app.module.ts y src/data-source.ts),
# NO "DATABASE_HOST"/"DATABASE_USER"/etc. Las únicas variables con prefijo
# "DATABASE_" son DATABASE_SSL y DATABASE_SSL_REJECT_UNAUTHORIZED (SEC-004).

NODE_ENV=production
PORT=3001

# Opción A (recomendada): RDS — completar con el endpoint real de RDS.
# Opción B (temporal): apuntar al servicio "postgres" de docker-compose.prod.yml.
DB_HOST=postgres
DB_PORT=5432
DB_USER=agro_user
DB_PASSWORD=change-me-strong-password
DB_NAME=agro_score

# SEC-004: contra RDS, poner DATABASE_SSL=true (RDS lo requiere/recomienda
# por default). DATABASE_SSL_REJECT_UNAUTHORIZED=false solo como paso
# transitorio si el certificado todavía no está validado — nunca dejarlo
# así en producción estable.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# El esquema se versiona con migrations. NUNCA true en producción — ver
# README.md sección "Migraciones".
TYPEORM_SYNCHRONIZE=false

# Obligatoria — el backend falla al arrancar si falta o queda vacía (SEC-002).
# Generar con: openssl rand -base64 48
JWT_SECRET=change-me-long-random-secret
JWT_EXPIRES_IN=7d

# Nombre del servicio del worker en la red interna de Docker Compose — NO
# una URL pública. El worker nunca debe quedar expuesto a internet (SEC-005).
PYTHON_WORKER_URL=http://agro-score-worker:8000

# FRONTEND_URL: mantenido por compatibilidad (fallback de CORS si CORS_ORIGIN
# está vacía). En producción usar CORS_ORIGIN, que soporta múltiples origins.
FRONTEND_URL=https://agroscorelatam.com

# CORS_ORIGIN: lista separada por comas de los origins EXACTOS desde donde
# se sirve la landing (S3/CloudFront/dominio propio). Nunca "*". Completar
# con el/los origin(s) reales confirmados antes de habilitar el acceso
# público — ver docs/audits/deploy-aws-1.md para cómo confirmarlos.
CORS_ORIGIN=https://agroscorelatam.com,https://www.agroscorelatam.com

# CONTACT-1 / ACCESS-REQUEST-1: /contact y /access-request comparten estas
# variables (mismo remitente/destinatario/dry-run). Ver docs/contact-email.md
# y docs/audits/access-request-flow.md.
CONTACT_TO_EMAIL=agroscorelatam@gmail.com
CONTACT_FROM_EMAIL="AgroScore <onboarding@resend.dev>"
CONTACT_EMAIL_PROVIDER=resend
# false en producción real — con true, /contact y /access-request responden
# ok pero no mandan ningún email (ver SEC-013, agregar a smoke tests).
CONTACT_EMAIL_DRY_RUN=false
# Secreto real — nunca commitear. Requerida porque CONTACT_EMAIL_DRY_RUN=false
# (ADMIN-3: también porque EMAIL_DRY_RUN=false más abajo — un solo secreto
# compartido entre /contact y el envío de invitaciones/password-reset).
RESEND_API_KEY=

# ADMIN-3: envío real de email para invitaciones (POST /admin/invitations) y
# password-reset (POST /admin/users/:id/password-reset). Ver
# docs/invitation-password-reset-email.md. Sin EMAIL_FROM/EMAIL_DRY_RUN
# explícitas acá, caerían a las CONTACT_* de arriba (mismo remitente/modo) —
# se dejan explícitas para que quede claro qué controla qué en producción.
EMAIL_PROVIDER=resend
EMAIL_FROM="AgroScore <no-reply@agroscorelatam.com>"
# false en producción real — con true, las invitaciones/reset responden ok
# pero no mandan ningún email (mismo criterio que CONTACT_EMAIL_DRY_RUN).
EMAIL_DRY_RUN=false

# Base para armar los links de invitación/reset (agro-score-web, donde viven
# esas pantallas públicas — ver docs/admin-backend.md). Sin esta variable
# caería a FRONTEND_URL (que ya apunta acá arriba), así que en este template
# es redundante pero se deja explícita por claridad.
APP_PUBLIC_URL=https://agroscorelatam.com
