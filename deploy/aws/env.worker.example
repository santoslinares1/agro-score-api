# DEPLOY-AWS-1 — env productivo del worker (agro-score-worker).
# Copiar a deploy/aws/.env.worker en la EC2. No es información tan sensible
# como el JWT_SECRET/RESEND_API_KEY (son IDs de proyecto GCP, no
# credenciales), pero igual conviene no commitear el .env real por higiene.

EARTH_ENGINE_PROJECT=digimat-434101
EE_PROJECT_ID=digimat-434101

# Ruta DENTRO del contenedor al JSON del service account — coincide con el
# mount read-only definido en docker-compose.prod.yml. El archivo real vive
# en el host en /opt/agroscore/secrets/gee-service-account.json (ver
# README.md paso 7) y NUNCA se copia dentro de la imagen ni se commitea.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gee-service-account.json

# SEC-005/SEC-007 (SEC-FIX-1): límites de input de POST /analyze. Estos son
# los mismos defaults que ya usa el código si no se setean — repetidos acá
# para que quede explícito qué límites rigen en producción.
AGROSCORE_MAX_LOTS=50
AGROSCORE_MAX_CAMPAIGNS=8
AGROSCORE_MAX_GEOMETRY_COORDINATES=5000
AGROSCORE_MAX_DATE_RANGE_DAYS=366
AGROSCORE_MAX_CLOUDINESS=80

# SEC-003 (implementado — reemplaza la deuda antes documentada acá como SEC-FIX-2): el worker
# exige este secreto en el header X-Worker-Token para POST /analyze y POST /weekly-report/spike
# (app/worker_auth.py); agro-score-api lo manda en cada llamada a esas dos rutas (ver
# PythonWorkerService). GET /health queda público a propósito (agro-score-api tampoco lo manda
# ahí). El worker FALLA AL ARRANCAR si esta variable falta o queda vacía. Debe coincidir
# EXACTAMENTE con WORKER_INTERNAL_TOKEN de deploy/aws/env.backend.example. La protección por red
# (`expose` sin `ports` en docker-compose.prod.yml) sigue como defensa en profundidad, no
# reemplazada por esto.
WORKER_INTERNAL_TOKEN=change-me-long-random-secret
