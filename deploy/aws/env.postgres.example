# DEPLOY-AWS-1 — solo aplica si se usa la Opción B (Postgres en Docker,
# temporal). Copiar a deploy/aws/.env.postgres. Si se usa RDS (Opción A,
# recomendada), este archivo y el servicio `postgres` del compose no hacen
# falta.
#
# Estos valores deben coincidir con DB_USER/DB_PASSWORD/DB_NAME en
# .env.backend — son la misma base, vista desde dos servicios distintos.

POSTGRES_DB=agro_score
POSTGRES_USER=agro_user
POSTGRES_PASSWORD=change-me-strong-password
