PORT=3001

DB_HOST=localhost
DB_PORT=5434
DB_USER=agro_user
DB_PASSWORD=agro_password
DB_NAME=agro_score

# SEC-004: SSL para Postgres/RDS. false en dev local (el Postgres de Docker
# local no habla TLS); true en producción contra RDS. Con DATABASE_SSL=true,
# REJECT_UNAUTHORIZED=false solo como paso transitorio si el certificado
# todavía no está validado (nunca dejarlo así en producción estable).
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Esquema versionado con migrations (npm run migration:*). Dejar en false
# salvo prototipado local muy puntual; nunca en producción.
TYPEORM_SYNCHRONIZE=false

# Obligatoria — el backend falla al arrancar si falta o queda vacía (SEC-002).
# Generar un valor largo y aleatorio, ej: openssl rand -base64 48
JWT_SECRET=change-me-long-random-secret
JWT_EXPIRES_IN=7d

# Apunta al worker FastAPI (agro-score-worker).
PYTHON_WORKER_URL=http://localhost:8000

FRONTEND_URL=http://localhost:4200

# DEPLOY-AWS-1: lista de origins permitidos separados por coma, para cuando
# la landing responde desde más de un origin (apex + www, o CloudFront
# mientras no haya dominio propio). Si se setea, tiene prioridad sobre
# FRONTEND_URL. En dev local dejarla vacía (alcanza con FRONTEND_URL).
# Ejemplo producción:
# CORS_ORIGIN=https://agroscorelatam.com,https://www.agroscorelatam.com
# ADMIN-1: cuando agro-score-admin (FASE 2) tenga dominio, sumarlo a esta
# lista sin sacar los anteriores, ej:
# CORS_ORIGIN=https://agroscorelatam.com,https://www.agroscorelatam.com,https://admin.agroscorelatam.com
CORS_ORIGIN=

# CONTACT-1: formulario de contacto público (POST /contact) enviado vía Resend.
# Ver docs/contact-email.md para el detalle completo.
# ACCESS-REQUEST-1: POST /access-request reutiliza estas mismas variables
# (mismo remitente/destinatario/dry-run que /contact). Ver
# docs/audits/access-request-flow.md.
CONTACT_TO_EMAIL=agroscorelatam@gmail.com
CONTACT_FROM_EMAIL="AgroScore <onboarding@resend.dev>"
CONTACT_EMAIL_PROVIDER=resend
# true = no llama a Resend, solo loguea el email que se hubiera enviado (no requiere API key).
CONTACT_EMAIL_DRY_RUN=true
# Secreto real — nunca commitear. Requerida cuando CONTACT_EMAIL_DRY_RUN=false
# o EMAIL_DRY_RUN=false (ADMIN-3: compartida entre /contact y el envío de
# invitaciones/password-reset — un solo proveedor transaccional, ver
# docs/invitation-password-reset-email.md).
RESEND_API_KEY=

# ADMIN-3: reemplazada por APP_PUBLIC_URL (ver más abajo) — las páginas
# públicas de accept-invitation/reset-password viven en agro-score-web, no
# en agro-score-admin. Se deja documentada por si algún .env real todavía la
# tiene seteada; el código ya no la lee.
# ADMIN_APP_URL=

# ADMIN-3: base para armar invitationUrl/resetUrl — tanto en el email real
# (siempre) como en la respuesta HTTP de dev/QA (NODE_ENV != production).
# Apunta a agro-score-web (ahí viven las páginas públicas de
# accept-invitation/reset-password, junto al login real de usuarios — ver
# docs/admin-backend.md). Sin esta variable, cae a FRONTEND_URL (que en
# producción ya vale https://agroscorelatam.com).
# Ejemplo producción: APP_PUBLIC_URL=https://agroscorelatam.com
APP_PUBLIC_URL=

# ADMIN-3: envío real de emails de invitación/password-reset. Mismo
# proveedor (Resend) y mismo RESEND_API_KEY que CONTACT_*, capa de
# variables separada para no acoplar ambos flujos. Si EMAIL_* no está
# seteada, cae a la CONTACT_* equivalente (así un .env de producción que ya
# tenga /contact configurado no necesita duplicar nada) — ver
# docs/invitation-password-reset-email.md para la precedencia completa.
EMAIL_PROVIDER=resend
EMAIL_FROM="AgroScore <no-reply@agroscorelatam.com>"
# true = no llama a Resend, solo loguea destinatario/asunto (nunca el
# token/link completo). Default true si ni EMAIL_DRY_RUN ni
# CONTACT_EMAIL_DRY_RUN están seteadas — nunca manda un email real por
# accidente.
EMAIL_DRY_RUN=true

# ADMIN-2: no está seteada en ningún lado del repo todavía. En local queda
# undefined (tratado como no-producción, que es lo que se quiere). El
# Dockerfile de este backend SÍ la define (NODE_ENV=production) — ver
# deploy/aws/env.backend.example.
NODE_ENV=
