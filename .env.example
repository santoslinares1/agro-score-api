PORT=3001

DB_HOST=localhost
DB_PORT=5434
DB_USER=agro_user
DB_PASSWORD=agro_password
DB_NAME=agro_score

# Esquema versionado con migrations (npm run migration:*). Dejar en false
# salvo prototipado local muy puntual; nunca en producción.
TYPEORM_SYNCHRONIZE=false

# Cambiar en producción — nunca usar este valor tal cual.
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Apunta al worker FastAPI (agro-score-worker).
PYTHON_WORKER_URL=http://localhost:8000

FRONTEND_URL=http://localhost:4200

# CONTACT-1: formulario de contacto público (POST /contact) enviado vía Resend.
# Ver docs/contact-email.md para el detalle completo.
CONTACT_TO_EMAIL=agroscorelatam@gmail.com
CONTACT_FROM_EMAIL="AgroScore <onboarding@resend.dev>"
CONTACT_EMAIL_PROVIDER=resend
# true = no llama a Resend, solo loguea el email que se hubiera enviado (no requiere API key).
CONTACT_EMAIL_DRY_RUN=true
# Secreto real — nunca commitear. Requerida solo cuando CONTACT_EMAIL_DRY_RUN=false.
RESEND_API_KEY=
