PORT=3001

DB_HOST=localhost
DB_PORT=5434
DB_USER=agro_user
DB_PASSWORD=agro_password
DB_NAME=agro_score

# SEC-004: SSL para Postgres/RDS. false en dev local (el Postgres de Docker
# local no habla TLS); true en producción contra RDS. Con DATABASE_SSL=true,
# REJECT_UNAUTHORIZED=false solo como paso transitorio si el certificado
# todavía no está validado (nunca dejarlo así en producción estable).
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Esquema versionado con migrations (npm run migration:*). Dejar en false
# salvo prototipado local muy puntual; nunca en producción.
TYPEORM_SYNCHRONIZE=false

# Obligatoria — el backend falla al arrancar si falta o queda vacía (SEC-002).
# Generar un valor largo y aleatorio, ej: openssl rand -base64 48
JWT_SECRET=change-me-long-random-secret
JWT_EXPIRES_IN=7d

# Apunta al worker FastAPI (agro-score-worker).
PYTHON_WORKER_URL=http://localhost:8000

FRONTEND_URL=http://localhost:4200

# DEPLOY-AWS-1: lista de origins permitidos separados por coma, para cuando
# la landing responde desde más de un origin (apex + www, o CloudFront
# mientras no haya dominio propio). Si se setea, tiene prioridad sobre
# FRONTEND_URL. En dev local dejarla vacía (alcanza con FRONTEND_URL).
# Ejemplo producción:
# CORS_ORIGIN=https://agroscorelatam.com,https://www.agroscorelatam.com
# ADMIN-1: cuando agro-score-admin (FASE 2) tenga dominio, sumarlo a esta
# lista sin sacar los anteriores, ej:
# CORS_ORIGIN=https://agroscorelatam.com,https://www.agroscorelatam.com,https://admin.agroscorelatam.com
CORS_ORIGIN=

# SMTP-MIGRATION-1: todo el envío de mails (invitación/reset, reporte semanal, solicitud de
# acceso, consulta pública) pasó de Resend a SMTP directo contra Google Workspace. Ver
# docs/email-configuration.md para la arquitectura completa (cuenta real vs. alias vs. grupos).
#
# Mapping de variables viejas -> nuevas (las viejas quedan documentadas más abajo, deprecadas,
# como fallback si un .env real todavía no migró):
#   CONTACT_TO_EMAIL / CONTACT_FROM_EMAIL  -> CONTACT_EMAIL / MAIL_FROM
#   CONTACT_EMAIL_PROVIDER / EMAIL_PROVIDER -> MAIL_PROVIDER
#   CONTACT_EMAIL_DRY_RUN / EMAIL_DRY_RUN  -> MAIL_DRY_RUN
#   EMAIL_FROM                              -> MAIL_FROM
#   RESEND_API_KEY                          -> SMTP_PASS (ya no es una API key, es el app
#                                               password de la cuenta real de Google Workspace)

MAIL_PROVIDER=smtp

# Cuenta real de Google Workspace — única credencial SMTP del backend. NUNCA usar contacto@ ni
# reportes@ acá: son grupos de Google, no cuentas, y no tienen password propio.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=slinares@agroscorelatam.com
# Secreto real — nunca commitear. App password de Google Workspace (no la password normal de la
# cuenta), generado en https://myaccount.google.com/apppasswords. Requerido cuando
# MAIL_DRY_RUN=false.
SMTP_PASS=

# Remitente visible de todos los mails salientes. Debe estar configurado en Google Workspace como
# alias autorizado de SMTP_USER ("Enviar correo como" en la configuración de Gmail) — el backend
# no lo valida, es responsabilidad de la configuración de Workspace.
MAIL_FROM=no-reply@agroscorelatam.com
# Reply-to por default para invitación/reset/reporte semanal. Solicitud de acceso y consulta
# pública usan el email del solicitante como reply-to; si no es válido, caen acá también.
MAIL_REPLY_TO=contacto@agroscorelatam.com

# Destinatario de /access-request y /contact — grupo de Google, no cuenta SMTP.
CONTACT_EMAIL=contacto@agroscorelatam.com
# BCC del reporte semanal automático — grupo de Google que archiva copia de cada reporte enviado
# al usuario final. Opcional: si queda vacía, el reporte se manda igual, sin bcc.
REPORTS_BCC_EMAIL=reportes@agroscorelatam.com

# true = no llama a SMTP, solo loguea el email que se hubiera enviado (no requiere SMTP_PASS).
# Default true si no está seteada — nunca manda un email real por accidente.
MAIL_DRY_RUN=true

# --- Deprecadas (SMTP-MIGRATION-1) ---------------------------------------------------------
# Se mantienen documentadas por si algún .env real todavía las tiene seteadas — EmailService cae
# a ellas si las variables MAIL_*/CONTACT_EMAIL de arriba no están, pero ya no se usan en
# producción y no deberían setearse en un .env nuevo.
# CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL=
# CONTACT_EMAIL_PROVIDER=resend
# CONTACT_EMAIL_DRY_RUN=
# EMAIL_PROVIDER=resend
# EMAIL_FROM=
# EMAIL_DRY_RUN=
# RESEND_API_KEY=

# ADMIN-3: reemplazada por APP_PUBLIC_URL (ver más abajo) — las páginas
# públicas de accept-invitation/reset-password viven en agro-score-web, no
# en agro-score-admin. Se deja documentada por si algún .env real todavía la
# tiene seteada; el código ya no la lee.
# ADMIN_APP_URL=

# ADMIN-3: base para armar invitationUrl/resetUrl — tanto en el email real
# (siempre) como en la respuesta HTTP de dev/QA (NODE_ENV != production).
# Apunta a agro-score-web (ahí viven las páginas públicas de
# accept-invitation/reset-password, junto al login real de usuarios — ver
# docs/admin-backend.md). Sin esta variable, cae a FRONTEND_URL (que en
# producción ya vale https://agroscorelatam.com).
# Ejemplo producción: APP_PUBLIC_URL=https://agroscorelatam.com
APP_PUBLIC_URL=

# ADMIN-2: no está seteada en ningún lado del repo todavía. En local queda
# undefined (tratado como no-producción, que es lo que se quiere). El
# Dockerfile de este backend SÍ la define (NODE_ENV=production) — ver
# deploy/aws/env.backend.example.
NODE_ENV=

# PR 11B: veredicto técnico automático de cada análisis. Ver
# docs/technical-verdict-claude.md para el detalle completo.
# deterministic (default si queda vacía o con un valor no reconocido) = reglas locales,
# sin llamar a ningún servicio externo, no requiere API key.
# claude = interpretación real vía Anthropic (server-side, nunca desde el frontend).
TECHNICAL_VERDICT_PROVIDER=deterministic
# Secreto real — nunca commitear. Solo requerida cuando TECHNICAL_VERDICT_PROVIDER=claude; si
# falta, el veredicto de ese análisis queda status=failed (el análisis en sí sigue Finalizado).
ANTHROPIC_API_KEY=
# Vacía = usa el default interno (ver DEFAULT_ANTHROPIC_MODEL en
# claude-technical-verdict.generator.ts).
ANTHROPIC_MODEL=
# Timeout por request a Anthropic, en milisegundos. Vacío = 20000 (20s).
ANTHROPIC_TIMEOUT_MS=

# PR 16B: diagnóstico semanal comparativo (weeklyTechnicalVerdict) — interpreta la EVOLUCIÓN de
# un campo vs. su reporte semanal anterior, distinto del veredicto individual de arriba. Ver
# docs/weekly-technical-verdict.md. Env separada a propósito (no reusa TECHNICAL_VERDICT_PROVIDER):
# permite apagar solo esta feature (nueva) sin tocar el veredicto individual (ya estable).
# deterministic (default) = reglas locales sobre comparisonVsPrevious, sin red, sin API key.
# claude = interpretación real vía Anthropic (reutiliza ANTHROPIC_API_KEY/ANTHROPIC_MODEL/
# ANTHROPIC_TIMEOUT_MS de arriba, no agrega variables de modelo/timeout propias).
WEEKLY_TECHNICAL_VERDICT_PROVIDER=deterministic
